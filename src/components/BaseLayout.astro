---
/**
 * @file Provides shared metadata, structured data, global styles, header, main, and footer.
 * Functions: none; layout composition and safe JSON-LD serialization.
 * Variables: title, description, canonicalPath, image, and structuredData props.
 * Line locations: see docs/CODE_INDEX.md for the generated symbol index.
 */
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { absoluteUrl, withBase } from "@/lib/url";
import "@/styles/global.css";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  structuredData?: Readonly<Record<string, unknown>>;
};

const { title, description, canonicalPath = "", structuredData } = Astro.props;
const canonical = absoluteUrl(canonicalPath);
const socialImage = absoluteUrl("images/portfolio-preview.svg");
const safeStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07151d" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={withBase("manifest.webmanifest")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Jason Stys project feed"
      href={absoluteUrl("feed.xml")}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {safeStructuredData && (
      <script type="application/ld+json" set:html={safeStructuredData}></script>
    )}
  </head>
  <body>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
