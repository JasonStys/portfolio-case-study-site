---
/**
 * @file Pre-renders all 67 project purposes, latest workflows, exact-source evidence and limits.
 * Functions: getStaticPaths; static domain and separately identified portfolio-hub rendering.
 * Variables: project, upgrade, previous, next and observedAt; no browser data fetches.
 * Line locations: see docs/CODE_INDEX.md for the generated symbol index.
 */
import BaseLayout from "@/components/BaseLayout.astro";
import { projects } from "@/lib/catalog";
import { projectUpgrade, upgradeManifest } from "@/lib/upgrades";
import type { Project } from "@/lib/types";
import { withBase } from "@/lib/url";

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { name: project.name },
    props: { project, previous: projects[index - 1], next: projects[index + 1] },
  }));
}

type Props = { project: Project; previous?: Project; next?: Project };
const { project, previous, next } = Astro.props;
const upgrade = projectUpgrade(project.name);
const isHub = project.name === "portfolio-case-study-site";
if (!upgrade && !isHub) throw new Error(`Missing source evidence for ${project.name}.`);
const observedAt = new Date(upgradeManifest.collectedAt).toISOString();
---

<BaseLayout
  title={`${project.name} — project evidence — Jason Stys`}
  description={upgrade?.summary ?? project.description}
  canonicalPath={`projects/${project.name}/`}
>
  <article class="project-detail section-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={withBase("")}>Overview</a>
      <span aria-hidden="true">/</span>
      <a href={withBase("projects/")}>Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>
    <header class="project-detail__hero">
      <p class="eyebrow">
        Project {String(project.portfolioOrder).padStart(2, "0")} · {project.primaryLanguage}
      </p>
      <h1>{project.name}</h1>
      <p class="case-summary">{project.description}</p>
      <div class="button-row">
        <a class="button button--primary" href={project.url}>
          Inspect repository ↗
        </a>
        {project.caseStudySlug && (
          <a
            class="button button--secondary"
            href={withBase(`case-studies/${project.caseStudySlug}/`)}
          >
            Read case study →
          </a>
        )}
      </div>
    </header>
    <div class="project-detail__grid">
      <section class="project-detail__section" aria-labelledby="purpose-title">
        <p class="eyebrow">Purpose and fit</p>
        <h2 id="purpose-title">What the project does</h2>
        <p>{project.outcome}</p>
        <h3>Relevant work</h3>
        <p>{project.roles.join(" · ")}</p>
        <h3>Technologies</h3>
        <p>{project.languages.join(" · ")}</p>
      </section>
      {upgrade ? (
        <>
          <section
            class="project-detail__section"
            aria-labelledby="changes-title"
            data-project-upgrade
          >
            <p class="eyebrow">Latest practical workflow</p>
            <h2 id="changes-title">What changed</h2>
            <p>{upgrade.summary}</p>
            <h3>Why it helps</h3>
            <p>{upgrade.rationale}</p>
          </section>
          <section
            class="project-detail__section project-detail__evidence"
            aria-labelledby="source-title"
          >
            <p class="eyebrow">Inspectable source evidence</p>
            <h2 id="source-title">Validation at this commit</h2>
            <p>
              These links describe the reviewed source commit, not every future change or an older
              downloadable release. Local measurements and their conditions are recorded in the
              report; linked main-branch workflow runs passed for this same commit when collected.
            </p>
            <dl class="source-identity">
              <dt>Source commit</dt>
              <dd>
                <a href={upgrade.sourceUrl}>
                  <code>{upgrade.sourceCommit}</code>
                </a>
              </dd>
              <dt>Evidence collected (UTC)</dt>
              <dd>
                <time datetime={observedAt}>{observedAt}</time>
              </dd>
            </dl>
            <ul class="project-detail__links">
              <li>
                <a href={upgrade.validationReportUrl}>Read source-bound validation report ↗</a>
              </li>
              <li>
                <a href={upgrade.reviewUrl}>Review the change proposal ↗</a>
              </li>
              {upgrade.workflows.map((workflow) => (
                <li>
                  <a href={workflow.url}>{workflow.name} — successful main run ↗</a>
                </li>
              ))}
            </ul>
          </section>
          <section class="project-detail__section" aria-labelledby="limits-title">
            <p class="eyebrow">Scope and limits</p>
            <h2 id="limits-title">How to read the results</h2>
            <p>
              Portfolio and educational software: passing these checks establishes the documented
              behavior under those checks. It does not establish production readiness, certification
              or permission to operate a real system.
            </p>
            <ul class="project-detail__limits">
              {upgrade.limitations.map((limit) => (
                <li>{limit}</li>
              ))}
            </ul>
          </section>
        </>
      ) : (
        <section class="project-detail__section" aria-labelledby="hub-title" data-portfolio-hub>
          <p class="eyebrow">This portfolio hub</p>
          <h2 id="hub-title">Current site checks</h2>
          <p>
            This static site presents all 67 projects and source-bound upgrade evidence for the 66
            domain projects. It is validated separately by its own unit, browser, accessibility,
            asset-budget and deployment checks.
          </p>
          <p>
            The link below records this site's own publication checks. Results for the domain
            projects do not establish the outcome of a portfolio build.
          </p>
          <a class="text-link" href={`${project.url}/actions/workflows/ci.yml`}>
            Inspect current portfolio CI and Pages checks ↗
          </a>
        </section>
      )}
    </div>
    <nav class="project-detail__neighbors" aria-label="Browse projects in portfolio order">
      {previous && <a href={withBase(`projects/${previous.name}/`)}>← Previous: {previous.name}</a>}
      {next && <a href={withBase(`projects/${next.name}/`)}>Next: {next.name} →</a>}
    </nav>
  </article>
</BaseLayout>
