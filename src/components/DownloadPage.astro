---
/**
 * @file Renders current application packages in bounded static pages with separate runtime and guide identities.
 * Functions: static card rendering; variables: selection, applicationManifest and platform labels.
 * Line locations: see docs/CODE_INDEX.md. No client fetching or third-party resources.
 */
import BaseLayout from "@/components/BaseLayout.astro";
import DownloadPagination from "@/components/DownloadPagination.astro";
import { applicationManifest } from "@/lib/application-catalog";
import { selectDownloadPage } from "@/lib/download-pages";
import { withBase } from "@/lib/url";
type Props = { pageIndex: number };
const { pageIndex } = Astro.props;
const selection = selectDownloadPage(applicationManifest.applications, pageIndex);
const platforms = { windows: "Windows", linux: "Linux", macos: "macOS" };
---

<BaseLayout
  title={
    pageIndex === 1
      ? "Current application downloads — Jason Stys"
      : `Application downloads — page ${pageIndex} — Jason Stys`
  }
  description="Current released applications, Windows guides, exact runtime sources, prerequisites and checksum evidence."
  canonicalPath={selection.path}
>
  <header class="page-intro section-shell">
    <p class="eyebrow">Download and inspect</p>
    <h1>Try the released applications.</h1>
    <p>
      These 66 domain applications have published packages and actual Windows launch-and-use checks.
      Each guide explains its real workflow, data and exit behavior. This snapshot indexes the other
      66 apps; see{" "}
      <a href="https://github.com/JasonStys/portfolio-case-study-site/releases">
        portfolio Releases
      </a>{" "}
      for its current native package and verification status.
    </p>
    <p>
      Choose the exact platform and package kind. Portable archives need extraction; installers and
      disk images have different setup steps. Packages are unsigned. macOS and Linux entries below
      are published asset metadata; their presence does not establish execution on this Windows PC.
      Architecture “unspecified” means the filename and available evidence do not establish it.
    </p>
    <p>
      Verify the complete SHA-256 with the linked checksum. Displayed digests are 12-character
      prefixes; the <a href={withBase("downloads/index.json")}>full evidence index</a> contains all
      108 package identities, complete hashes, runtime sources and guide bindings.{" "}
      <a href={withBase("downloads/history/2026-11-10/")}>Earlier 20-project release snapshot</a>.
    </p>
    <p>
      Collected{" "}
      <time datetime={applicationManifest.collectedAt}>{applicationManifest.collectedAt}</time>.
      Source, documentation and packaged runtime commits remain separate. Windows acceptance is
      bounded to the documented journeys and does not establish a clean-machine installation,
      production suitability or publisher signature.
    </p>
    <p data-download-page={selection.page}>
      Showing {selection.first}–{selection.last} of {selection.totalEntries} released projects. Page{" "}
      {selection.page} of {selection.totalPages}.{" "}
      <a href="#download-pages">See all download pages</a>.
    </p>
  </header>
  <section class="section-shell section-block" aria-label="Released applications">
    <ol class="downloads-list" data-download-list start={selection.first}>
      {selection.items.map((project) => (
        <li id={project.name} data-download-project={project.name}>
          <h2>
            <a href={withBase(`projects/${project.name}/`)}>{project.name}</a>{" "}
            <small>v{project.version}</small>
          </h2>
          <p>{project.requirements}</p>
          <p class="download-proof">
            <a href={project.releaseUrl}>Release</a> ·{" "}
            <a href={project.runtimeSourceUrl}>App source {project.runtimeSource.slice(0, 12)}</a> ·{" "}
            <a href={project.guide.documentUrl}>Current Windows guide</a> ·{" "}
            <a href={project.guide.manifestUrl}>Guide identities</a>
          </p>
          <ul class="download-assets">
            {project.assets.map((asset) => (
              <li data-download-platform={asset.platform}>
                <a href={asset.url}>
                  {platforms[asset.platform]} {asset.architecture} ·{" "}
                  {asset.kind.replaceAll("-", " ")} {asset.format}
                </a>
                <a href={asset.checksumURL}>
                  {asset.checksumName === "SHA256SUMS.txt" ? "SHA-256 manifest" : "SHA-256"}
                </a>
                <code>{asset.sha256.slice(0, 12)}</code>
              </li>
            ))}
          </ul>
          <p class="download-limit">{project.limitations[0]}</p>
        </li>
      ))}
    </ol>
  </section>
  <DownloadPagination current={selection.page} total={selection.totalPages} />
</BaseLayout>
<style is:global>
  .downloads-list {
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }
  .downloads-list > li {
    padding-block: 1rem;
    border-bottom: 1px solid currentColor;
  }
  .downloads-list h2 {
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }
  .downloads-list small {
    font-size: 0.85rem;
  }
  .downloads-list p {
    margin-block: 0.6rem;
  }
  .download-assets {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }
  .download-assets li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
  }
  .download-assets code {
    font-size: 0.8rem;
  }
  .download-proof,
  .download-limit {
    font-size: 0.9rem;
  }
  .download-limit {
    max-width: 75ch;
  }
</style>
