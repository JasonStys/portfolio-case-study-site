---
/**
 * @file Presents one searchable project with outcome, evidence tags, and destination links.
 * Functions: none; deterministic project-card rendering.
 * Variables: project and compact component props.
 * Line locations: see docs/CODE_INDEX.md for the generated symbol index.
 */
import { withBase } from "@/lib/url";
import type { Project } from "@/lib/types";

type Props = { project: Project; compact?: boolean };
const { project, compact = false } = Astro.props;
const detailHref = project.caseStudySlug
  ? withBase(`case-studies/${project.caseStudySlug}/`)
  : project.url;
---

<article
  class:list={["project-card", { "project-card--compact": compact }]}
  data-project-card
  data-project-id={project.name}
>
  <div class="project-card__topline">
    <span class="project-card__language">{project.primaryLanguage}</span>
    <span class="status-dot">
      <i aria-hidden="true"></i>
      {project.maturity}
    </span>
  </div>
  <h3>
    <a href={detailHref}>{project.name}</a>
  </h3>
  <p class="project-card__outcome">{project.outcome}</p>
  {!compact && <p class="project-card__description">{project.description}</p>}
  <ul class="tag-list" aria-label={`Technologies in ${project.name}`}>
    {project.languages.slice(0, compact ? 3 : 5).map((language) => (
      <li>{language}</li>
    ))}
  </ul>
  <div class="project-card__actions">
    {project.caseStudySlug && (
      <a class="text-link" href={detailHref}>
        Read case study <span aria-hidden="true">→</span>
      </a>
    )}
    <a class="text-link text-link--muted" href={project.url}>
      Repository <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
